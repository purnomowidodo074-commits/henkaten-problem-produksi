# ============================================================
# TEMPLATE ENVIRONMENT VARIABLES
# Salin file ini menjadi .env lalu isi nilainya
# File .env TIDAK boleh di-commit ke GitHub
# ============================================================

# ----------------------------
# DATABASE
# ----------------------------

# Untuk pengembangan lokal (SQLite):
DATABASE_URL="file:./dev.db"

# Untuk produksi (PostgreSQL — isi sesuai yang diberikan Insforge):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Contoh:
# DATABASE_URL="postgresql://admin:rahasia123@db.insforge.io:5432/henkaten_db?schema=public"

# ----------------------------
# SETTING (tambah line & PIC perbaikan)
# ----------------------------
# Kredensial untuk mengakses fitur Setting di navbar (login dulu)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
